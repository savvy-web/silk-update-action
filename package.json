{
	"name": "silk-update-action",
	"version": "4.15.4",
	"private": true,
	"description": "GitHub Action for updating pnpm config dependencies and regular dependencies with automated PR creation",
	"keywords": ["github-action", "pnpm", "config-dependencies", "dependency-updates", "monorepo", "changesets"],
	"homepage": "https://github.com/savvy-web/silk-update-action#readme",
	"bugs": {
		"url": "https://github.com/savvy-web/silk-update-action/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/savvy-web/silk-update-action.git"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@savvyweb.systems",
		"url": "https://savvyweb.systems"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"build:prod": "effected action build",
		"ci:build": "CI=\"true\" turbo run build:prod --log-order=grouped --output-logs=full --log-prefix=none",
		"ci:test": "effected schema check lib/scripts/schemastore.config.ts && CI=\"true\" vitest run --coverage",
		"lint": "biome check --max-diagnostics=none",
		"lint:fix": "biome check --write --max-diagnostics=none",
		"lint:fix:unsafe": "biome check --write --unsafe --max-diagnostics=none",
		"lint:md": "markdownlint-cli2 --config './lib/configs/.markdownlint-cli2.jsonc'",
		"lint:md:fix": "markdownlint-cli2  --config './lib/configs/.markdownlint-cli2.jsonc' --fix",
		"prepare": "husky",
		"schema:build": "effected schema build lib/scripts/schemastore.config.ts",
		"schema:check": "effected schema check lib/scripts/schemastore.config.ts",
		"test": "vitest run --pass-with-no-tests",
		"test:coverage": "vitest run --coverage --pass-with-no-tests",
		"test:watch": "vitest --watch --pass-with-no-tests",
		"typecheck": "turbo run types:check --log-prefix=none --log-order=grouped",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/changesets": "catalog:effected",
		"@effected/commands": "catalog:effected",
		"@effected/git": "catalog:effected",
		"@effected/github": "catalog:effected",
		"@effected/github-actions": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/lockfiles": "catalog:effected",
		"@effected/npm": "catalog:effected",
		"@effected/package-json": "catalog:effected",
		"@effected/runtimes": "catalog:effected",
		"@effected/schemastore": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@savvy-web/silk-effects": "^12.0.0",
		"effect": "catalog:effected"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/plugin": "catalog:effected",
		"@okfit/plugin": "^0.5.32",
		"@savvy-web/silk": "^5.1.1",
		"@vitest-agent/plugin": "^6.0.10"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.19.0",
			"onFail": "download"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.13.0",
				"onFail": "ignore"
			}
		]
	}
}
